{
  "name": "course-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,blue \"tsx watch server/index.ts\" \"vite\"",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "desktop:dev": "node desktop/build.mjs --shell-only && COURSE_STUDIO_DESKTOP_URL=http://127.0.0.1:4311 electron .desktop/app",
    "desktop:build": "npm run build && node desktop/build.mjs",
    "desktop:pack": "npm run desktop:build && electron-builder --mac dir",
    "desktop:dist": "npm run desktop:build && electron-builder --mac dmg",
    "desktop:install": "npm run desktop:pack && node desktop/install.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "chokidar": "5.0.0",
    "express": "5.2.1",
    "html2canvas": "1.4.1",
    "lucide-react": "0.546.0",
    "pinyin-pro": "^3.29.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "9.2.4",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
